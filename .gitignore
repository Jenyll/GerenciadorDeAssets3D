cat > .gitignore <<'EOF'
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Node
node_modules/
dist/
build/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment
.env
.env.local
.env.*.local

# SQLite local database
*.db
*.db-shm
*.db-wal

# Local uploads/storage
storage/
**/storage/

# .NET
bin/
obj/
[Bb]in/
[Oo]bj/
*.user
*.suo
*.rsuser

# IDEs
.vscode/
.idea/
*.code-workspace

# Logs
*.log
logs/
EOF